# Copia este archivo como .env y rellénalo. El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# Nunca pongas aquí claves privadas ni frases semilla de wallets: este programa no las necesita.

# Obligatoria. Cuenta gratuita en https://www.helius.dev  → "API Keys"
HELIUS_API_KEY=

# Solo si quieres avisos por correo (README, paso 5). Gmail exige una "contraseña de aplicación",
# no tu contraseña normal.
SMTP_USER=
SMTP_PASSWORD=
